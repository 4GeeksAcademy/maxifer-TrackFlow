# Copy to .env at the repository root. Never commit the real .env.
JWT_SECRET=
ACCESS_TOKEN_EXPIRE_MINUTES=30
# Self-contained development storage; PostgreSQL/Supabase URLs also work.
DATABASE_URL=sqlite:////app/services/api/data/inventory.sqlite3
DEMO_DATA_ENABLED=true
BACKEND_INTERNAL_URL=http://services:8000
# Browser-facing URL used in password-reset emails.
FRONTEND_URL=http://localhost:3001
RESEND_API_KEY=
EMAIL_FROM=TrackFlow <onboarding@resend.dev>
# Existing external candidates API (not implemented by the incidents API).
# Public URL: used by both the browser and the Next.js server.
NEXT_PUBLIC_API_URL=
WATCHPACK_POLLING=true
WATCHFILES_FORCE_POLLING=true
LANDING_PORT=3000
BACKOFFICE_PORT=3001
TALENT_PORT=3002
API_PORT=8000
